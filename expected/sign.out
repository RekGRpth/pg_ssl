$$::text AS key;
-- success path: only stable properties are checked, since the PKCS7
-- signedAttrs embed a signing timestamp, making the raw output
-- non-reproducible across test runs
SELECT sign(cert, key, 'hello world') IS NOT NULL AS signed_ok FROM fixture;
 signed_ok 
-----------
 t
(1 row)

SELECT length(sign(cert, key, 'hello world')) > 0 AS has_content FROM fixture;
 has_content 
-------------
 t
(1 row)

SELECT sign(cert, key, 'hello world') ~ '^[A-Za-z0-9+/=]+$' AS looks_like_base64 FROM fixture;
 looks_like_base64 
-------------------
 t
(1 row)

-- null arguments are rejected
DO $$
BEGIN
    PERFORM sign(NULL, (SELECT key FROM fixture), 'x');
    RAISE EXCEPTION 'expected error for null cert';
EXCEPTION WHEN null_value_not_allowed THEN
    RAISE NOTICE 'null cert rejected as expected';
END $$;
NOTICE:  null cert rejected as expected
DO $$
BEGIN
    PERFORM sign((SELECT cert FROM fixture), NULL, 'x');
    RAISE EXCEPTION 'expected error for null key';
EXCEPTION WHEN null_value_not_allowed THEN
    RAISE NOTICE 'null key rejected as expected';
END $$;
NOTICE:  null key rejected as expected
DO $$
BEGIN
    PERFORM sign((SELECT cert FROM fixture), (SELECT key FROM fixture), NULL);
    RAISE EXCEPTION 'expected error for null data';
EXCEPTION WHEN null_value_not_allowed THEN
    RAISE NOTICE 'null data rejected as expected';
END $$;
NOTICE:  null data rejected as expected
-- malformed cert/key are rejected
DO $$
BEGIN
    PERFORM sign('not a cert', (SELECT key FROM fixture), 'x');
    RAISE EXCEPTION 'expected error for malformed cert';
EXCEPTION WHEN invalid_parameter_value THEN
    RAISE NOTICE 'malformed cert rejected as expected';
END $$;
NOTICE:  malformed cert rejected as expected
DO $$
BEGIN
    PERFORM sign((SELECT cert FROM fixture), 'not a key', 'x');
    RAISE EXCEPTION 'expected error for malformed key';
EXCEPTION WHEN invalid_parameter_value THEN
    RAISE NOTICE 'malformed key rejected as expected';
END $$;
NOTICE:  malformed key rejected as expected
-- cert and key swapped: X509 parser rejects a private key PEM as invalid
DO $$
BEGIN
    PERFORM sign((SELECT key FROM fixture), (SELECT cert FROM fixture), 'x');
    RAISE EXCEPTION 'expected error for swapped cert/key';
EXCEPTION WHEN invalid_parameter_value THEN
    RAISE NOTICE 'swapped cert/key rejected as expected';
END $$;
NOTICE:  swapped cert/key rejected as expected
DROP EXTENSION pg_ssl;
